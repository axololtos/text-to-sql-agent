# Google AI Studio API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_ai_studio_key_here

# Optional: override the Gemini model (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Failed SQL executions to self-correct before giving up (CLI: --max-repair-attempts)
MAX_REPAIR_ATTEMPTS=3

# LangSmith (optional - for tracing and monitoring)
LANGCHAIN_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=text2sql-agent
